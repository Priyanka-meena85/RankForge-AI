NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://rankforge:replace-this-password@localhost:5432/rankforge
SESSION_SECRET=replace-me
# Configure a TLS-capable SMTP URL and sender address to enable registration.
SMTP_URL=
EMAIL_FROM=
APP_ORIGIN=http://localhost:3000
# Production requires certificate and hostname verification.
# For a private database CA, set DATABASE_SSL_CA to its PEM certificate.
# Keep PostgreSQL TLS options out of DATABASE_URL; use these settings instead.
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=35000
PG_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Comma-separated trusted proxy IPs/CIDRs outside Render.
TRUST_PROXY=
# Create recurring monthly Stripe prices and a webhook endpoint before production launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
